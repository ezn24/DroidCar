#!/bin/sh
# Pre-push safety net: scan the author and committer emails of all **commits about to be pushed**,
# and refuse the push as soon as a non-noreply email appears (public repository; a pushed commit cannot truly be retracted).
#
# Why this layer is needed on top of the commit hook:
# - `git commit --no-verify` can bypass pre-commit;
# - cherry-pick / rebase / merge **keep the original author**, which pre-commit cannot see;
# - commits pulled in from other repositories carry the other side's email.
# This layer checks "the objects about to leave this machine" and covers all of the above.
set -eu
cd "$(git rev-parse --show-toplevel)"

ALLOWED_DOMAIN="users.noreply.github.com"
ZERO="0000000000000000000000000000000000000000"

fail=0
# Each stdin line: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
    [ -z "${local_sha:-}" ] && continue
    [ "${local_sha}" = "${ZERO}" ] && continue # branch deletion, no commits

    if [ "$remote_sha" = "$ZERO" ]; then
        # The remote does not have this branch yet: check the whole history
        range="$local_sha"
        label="full history"
    else
        # The remote already has it: check only the new part
        range="$remote_sha..$local_sha"
        label="incremental"
    fi

    # Check both author and committer emails (GitHub shows both)
    bad=$(
        git log --format='%ae%n%ce' $range 2>/dev/null |
            grep -v "@${ALLOWED_DOMAIN}$" |
            grep -v '^$' |
            sort -u || true
    )

    if [ -n "$bad" ]; then
        echo ""
        echo "✗ push blocked: ${local_ref} → ${remote_ref}(${label}) contains non-allowlisted emails:"
        printf '%s\n' "$bad" | sed 's/^/    /'
        echo ""
        echo "  This repository only allows *@${ALLOWED_DOMAIN} (public repository; avoids leaking a company email)."
        echo "  Fix options:"
        echo "    · not yet committed: git config user.email '62716651+ezn24@users.noreply.github.com'"
        echo "    · committed but not pushed: rewrite the author, then push again"
        echo "    · history from other repositories: rewrite with git filter-branch/filter-repo, then push"
        echo ""
        fail=1
    fi
done

exit $fail
