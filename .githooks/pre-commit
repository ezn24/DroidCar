#!/bin/sh
# Pre-commit guard: author email allowlist + auto-formatting + Android Lint.
# Enabled per repository convention via `git config core.hooksPath .githooks` (run once after cloning).
set -eu
cd "$(git rev-parse --show-toplevel)"

# 0) Author email guard: this is a public repository, company/private emails **must not** be written into commit history
# (once pushed a commit cannot truly be retracted, and GitHub indexes author emails permanently).
# The allowlist is written here; update it together when a new legitimate identity is added.
ALLOWED_EMAIL_DOMAIN="users.noreply.github.com"
AUTHOR_EMAIL=$(git config user.email || echo "")
case "$AUTHOR_EMAIL" in
*"@$ALLOWED_EMAIL_DOMAIN") ;;
*)
    echo ""
    echo "✗ commit blocked: current user.email = '${AUTHOR_EMAIL}'"
    echo "  This repository only allows emails of the form *@${ALLOWED_EMAIL_DOMAIN} (public repository; avoids leaking a company email)."
    echo "  Fix: git config user.email '62716651+ezn24@users.noreply.github.com'"
    echo "  (This repository's .git/config should already set it; if overridden, check for --global or environment variables)"
    echo ""
    exit 1
    ;;
esac

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# 1) Formatting: only when Kotlin / Gradle scripts are staged
if printf '%s\n' "$STAGED" | grep -qE '\.(kt|kts)$'; then
    echo "▶ pre-commit check: code formatting (spotlessApply)..."
    ./gradlew --console=plain -q spotlessApply

    # Re-stage only files that "were already staged and changed by formatting"
    for f in $STAGED; do
        case "$f" in
        *.kt | *.kts)
            if ! git diff --quiet -- "$f" 2>/dev/null; then
                git add -- "$f"
                echo "  auto-formatted and re-staged: $f"
            fi
            ;;
        esac
    done
fi

# 2) Lint: only when sources/resources/build scripts are staged (existing issues are exempted in lint-baseline.xml)
if printf '%s\n' "$STAGED" | grep -qE '^(app/src/|[^ ]*\.gradle\.kts$|gradle\.properties$)'; then
    echo "▶ pre-commit check: Android Lint (lintStandardDebug)..."
    if ./gradlew --console=plain -q :app:lintStandardDebug; then
        echo "✓ lint passed"
    else
        echo ""
        echo "✗ lint failed, commit blocked."
        echo "  Report: app/build/reports/lint-results-debug.html"
        echo "  Fix the issues and retry; if it is a false positive, turn it off in the lint block of app/build.gradle.kts,"
        echo "  by issue id, or update the baseline after review (./gradlew :app:updateLintBaseline)."
        exit 1
    fi
fi

exit 0
