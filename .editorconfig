root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Read by ktlint (run through Spotless)
[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# The code uses "KDoc summary + paragraph comments (section notes)"; this rule conflicts with it and cannot auto-fix
ktlint_standard_no-consecutive-comments = disabled
# Keep explicit imports, never collapse them into wildcard imports
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_with_prefix = 2147483647
