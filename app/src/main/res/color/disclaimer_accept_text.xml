<?xml version="1.0" encoding="utf-8"?>
<!-- Text colour of the "Accept" button: light while disabled (countdown running / not scrolled to the end),
     because the disabled background is a very faint sky blue (#247EDCE6) and dark text was nearly invisible on it.
     The countdown seconds must stay readable, or users cannot tell why the button does nothing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="#9AB0BEBE"
        android:state_enabled="false" />
    <item android:color="@color/m3_on_primary" />
</selector>
