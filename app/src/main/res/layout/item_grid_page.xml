<?xml version="1.0" encoding="utf-8"?>
<!-- One page of the icon grid (always 4 columns; rows set in code by orientation: 3 in landscape like CarPlay,
     up to 6 in portrait so fixed 3 rows do not stretch cells into tall strips; cell size computed from the screen) -->
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="4"
    android:alignmentMode="alignMargins"
    android:useDefaultMargins="false"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="30dp" />
