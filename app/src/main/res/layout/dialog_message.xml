<?xml version="1.0" encoding="utf-8"?>
<!-- Shared dark message dialog (title + scrollable body + main action on the right).
     Same look as the disclaimer and the head-unit picker: bg_dialog_panel + M3 tokens + pill buttons.
     The system AlertDialog's light default theme clashed with the app's dark UI (seen on a phone 2026-10-18),
     so prompts always go through DarkMessageDialog, never a bare AlertDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/msgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/m3_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Body: scrolls when long (at most 46% of the screen height, capped in code); the buttons stay visible -->
    <ScrollView
        android:id="@+id/msgScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/msgBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/m3_on_var"
            android:textSize="12.5sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/msgActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal" />
</LinearLayout>
