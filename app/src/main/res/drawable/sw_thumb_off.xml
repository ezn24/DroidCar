<?xml version="1.0" encoding="utf-8"?>
<!-- 外框必须与 sw_thumb_on 同为 24dp：SwitchCompat 按建立当下的圆钮固有尺寸量测整个开关，
     关闭态若只有 16dp，一开始就是「关」的开关会被量窄、轨道小一号（与其它开关不统一）。
     视觉上仍是 MD3 关闭态的 16dp 小圆。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <size android:width="24dp" android:height="24dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="16dp" android:height="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/m3_switch_thumb_off" />
        </shape>
    </item>
</layer-list>
