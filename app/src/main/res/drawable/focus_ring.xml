<?xml version="1.0" encoding="utf-8"?>
<!-- Focus frame (iDrive knob / steering-wheel D-pad navigation): a 3 dp stroke drawn only while focused.
     Used as the View's foreground, so it does not replace its background (the icon card colour is set in code). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="3dp"
                android:color="#FF4FC3F7" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
